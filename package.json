{
  "name": "reference-harmony-pages",
  "private": true,
  "version": "0.0.0",
  "description": "Online catalog (Vue) + HarmonyOS app",
  "type": "module",
  "scripts": {
    "build": "node ./tools/build_pages.mjs",
    "build:pages": "node ./tools/build_pages.mjs",
    "test:catalog-sources": "npm run build && node --test tools/tests/catalog_sources.integration.test.mjs",
    "export:app-icon": "node ./tools/export_app_icon.mjs",
    "test:app-icon": "node --test tools/tests/app_icon_consistency.test.mjs",
    "hooks:install": "git config core.hooksPath .githooks"
  }
}


